{
  "expo": {
    "name": "مكتبة أبو بسام - فحص",
    "slug": "abu-bassam-library-offline-diagnostic",
    "version": "6.0.2",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "abu-bassam-library-diagnostic",
    "android": {
      "package": "com.abubassam.librarycamera3.diagnostic",
      "versionCode": 602,
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#fffaf3"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "يحتاج تطبيق مكتبة أبو بسام إلى الكاميرا للمسح الضوئي وقراءة الباركود وتصوير المستندات."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "يستخدم تطبيق مكتبة أبو بسام المصادقة الحيوية لحماية تسجيل الدخول والبيانات."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "يستخدم تطبيق مكتبة أبو بسام المصادقة الحيوية لحماية بيانات تسجيل الدخول على هذا الجهاز."
        }
      ]
    ]
  }
}
